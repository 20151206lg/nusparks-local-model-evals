+#!/bin/bash
+# run_inkling_oc.sh [G] [P] [PG] : the Inkling cells through OpenCode 2.x (medium effort set in its config). Needs RUN, OPENCODE_RUN_CONFIG_HOME and a Strata serving on :8001.
+source "$(dirname "$0")/env.sh"
+for c in ${@:-P}; do run_cell.sh $c inkling-oc 90 400; done
+tl.sh "ALL CELLS DONE"
