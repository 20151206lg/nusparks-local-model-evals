diff --git a/evals/3-rocket-game/bin/accept_watch.sh b/evals/3-rocket-game/bin/accept_watch.sh
index d000c71..008144e 100755
--- a/evals/3-rocket-game/bin/accept_watch.sh
+++ b/evals/3-rocket-game/bin/accept_watch.sh
@@ -1,7 +1,7 @@
 #!/bin/bash
 # accept_watch.sh : run the no-screenshot acceptance of each cell as soon as its END line appears. Needs RUN.
 source "$(dirname "$0")/env.sh"
-for CELL in G-clover P-clover G-mova P-mova; do
+for CELL in ${CELLS:-G-clover P-clover G-mova P-mova}; do  # CELLS="G-inkling P-inkling" (or P-inkling-oc) for the Inkling runs
   waited=0
   until grep -q "$CELL END\|$CELL ABORT" "$RUN/timeline.log"; do sleep 20; waited=$((waited+20)); [ "$waited" -ge "${MAX_WAIT_S:-14400}" ] && { tl.sh "$CELL acceptance gave up waiting (${MAX_WAIT_S:-14400}s)"; break; }; done
   grep -q "$CELL ABORT" "$RUN/timeline.log" && continue
diff --git a/evals/3-rocket-game/bin/capwatch.py b/evals/3-rocket-game/bin/capwatch.py
index 4430f17..c475e3b 100755
--- a/evals/3-rocket-game/bin/capwatch.py
+++ b/evals/3-rocket-game/bin/capwatch.py
@@ -10,7 +10,14 @@ def stop(tag, val):
     global fired
     if fired: return
     fired = True; open(pf + "." + tag, "w").write(str(val))
-    try: os.kill(int(open(pf).read().strip()), signal.SIGTERM)
+    try:
+        pid = int(open(pf).read().strip()); os.kill(pid, signal.SIGTERM)
+        def hard():  # an agent that ignores SIGTERM (seen once: Pi kept running after the cap) gets SIGKILL after 10 s, children first
+            time.sleep(10)
+            try:
+                import subprocess; subprocess.run(["pkill", "-KILL", "-P", str(pid)]); os.kill(pid, signal.SIGKILL)
+            except Exception: pass
+        threading.Thread(target=hard, daemon=True).start()
     except Exception as e: sys.stderr.write(f"capwatch: kill failed: {e}\n")
 def watch():
     while not done:
